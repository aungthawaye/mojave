            "required": false
          },
          {
            "in": "query",
            "name": "toDateTime",
            "type": "string",
            "format": "date-time",
            "description": "The end date for query (relates to central-ledger.settlement.createdDate). Can be used together with `fromDateTime'. eg 2017-07-21T17:32:28Z\n",
            "required": false
          },
