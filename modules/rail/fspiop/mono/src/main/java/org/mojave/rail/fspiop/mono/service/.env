## Mojave Mono Service

# Snowflake
SNOWFLAKE_NODE_ID=10

# Service Port
MOJAVE_SERVICE_PORT=5003

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_URL=localhost:9092

# FSPIOP Service Settings
FSPIOP_SERVICE_REQUEST_AGE_MS=300000
FSPIOP_SERVICE_REQUEST_AGE_VERIFICATION=true

# FSPIOP Participant Settings
FSPIOP_HUB_CODE=hub
FSPIOP_FSP_CODE=hub
FSPIOP_FSP_NAME=Mojave Hub
FSPIOP_CURRENCIES=USD,BYN,BHD,MMK
FSPIOP_ILP_SECRET=53cr3t
FSPIOP_SIGN_JWS=true
FSPIOP_VERIFY_JWS=true
FSPIOP_FSPS=wallet1,wallet2
# Private key for this FSP (PEM, single line or quoted/multiline as supported by your loader)
FSPIOP_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY----------END RSA PRIVATE KEY-----"
# Public keys of other FSPs (names must match FSPIOP_FSPS)
FSPIOP_PUBLIC_KEY_PEM_OF_WALLET1="-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----"
FSPIOP_PUBLIC_KEY_PEM_OF_WALLET2="-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----"

# Participant Store
PARTICIPANT_STORE_REFRESH_INTERVAL_MS=300000

# Intercom Base URLs
PARTICIPANT_INTERCOM_BASE_URL=http://localhost:5002
TRANSACTION_INTERCOM_BASE_URL=http://localhost:5002
WALLET_INTERCOM_BASE_URL=http://localhost:5002

# Quoting
QUOTING_STATEFUL=false

# Transfer Settings
TRANSFER_RESERVATION_TIMEOUT_MS=15000
TRANSFER_EXPIRY_TIMEOUT_MS=30000

# Read Database Configuration
READ_DB_URL=jdbc:mysql://localhost:3306/mv_mojave?createDatabaseIfNotExist=true
READ_DB_USER=root
READ_DB_PASSWORD=password
READ_DB_CONNECTION_TIMEOUT=30000
READ_DB_VALIDATION_TIMEOUT=5000
READ_DB_MAX_LIFETIME_TIMEOUT=1800000
READ_DB_IDLE_TIMEOUT=600000
READ_DB_KEEPALIVE_TIMEOUT=300000
READ_DB_MIN_POOL_SIZE=2
READ_DB_MAX_POOL_SIZE=2

# Write Database Configuration
WRITE_DB_URL=jdbc:mysql://localhost:3306/mv_mojave?createDatabaseIfNotExist=true
WRITE_DB_USER=root
WRITE_DB_PASSWORD=password
WRITE_DB_CONNECTION_TIMEOUT=30000
WRITE_DB_VALIDATION_TIMEOUT=5000
WRITE_DB_MAX_LIFETIME_TIMEOUT=1800000
WRITE_DB_IDLE_TIMEOUT=600000
WRITE_DB_KEEPALIVE_TIMEOUT=300000
WRITE_DB_MIN_POOL_SIZE=10
WRITE_DB_MAX_POOL_SIZE=10

# Flyway
FLYWAY_DB_URL=jdbc:mysql://localhost:3306/mv_mojave?createDatabaseIfNotExist=true
FLYWAY_DB_USER=root
FLYWAY_DB_PASSWORD=password
