# Participant Intercom Replier

# NATS
NATS_SERVERS=nats://localhost:4222
NATS_CONNECTION_NAME=participant-intercom-replier
NATS_USERNAME=
NATS_PASSWORD=
NATS_TOKEN=
NATS_CONNECTION_TIMEOUT_MS=5000
NATS_MAX_RECONNECTS=60
NATS_RECONNECT_WAIT_MS=2000
NATS_NO_ECHO=false

# Read Database Configuration
READ_DB_URL=jdbc:mysql://localhost:3306/mv_mojave?createDatabaseIfNotExist=true
READ_DB_USER=root
READ_DB_PASSWORD=password
READ_DB_CONNECTION_TIMEOUT=30000
READ_DB_VALIDATION_TIMEOUT=5000
READ_DB_MAX_LIFETIME_TIMEOUT=1800000
READ_DB_IDLE_TIMEOUT=600000
READ_DB_KEEPALIVE_TIMEOUT=300000
READ_DB_MIN_POOL_SIZE=2
READ_DB_MAX_POOL_SIZE=2

# Write Database Configuration
WRITE_DB_URL=jdbc:mysql://localhost:3306/mv_mojave?createDatabaseIfNotExist=true
WRITE_DB_USER=root
WRITE_DB_PASSWORD=password
WRITE_DB_CONNECTION_TIMEOUT=30000
WRITE_DB_VALIDATION_TIMEOUT=5000
WRITE_DB_MAX_LIFETIME_TIMEOUT=1800000
WRITE_DB_IDLE_TIMEOUT=600000
WRITE_DB_KEEPALIVE_TIMEOUT=300000
WRITE_DB_MIN_POOL_SIZE=2
WRITE_DB_MAX_POOL_SIZE=2

# Flyway
FLYWAY_DB_URL=jdbc:mysql://localhost:3306/mv_mojave?createDatabaseIfNotExist=true
FLYWAY_DB_USER=root
FLYWAY_DB_PASSWORD=password
